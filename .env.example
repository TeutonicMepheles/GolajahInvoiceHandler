# 复制为 .env.local 后填写。不要将真实密钥提交到版本控制。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
# 可选：覆盖默认的 %LOCALAPPDATA%\InvoiceAssistant\data 持久目录。
# INVOICE_APP_DATA_DIR=C:\Path\To\InvoiceAssistantData
# 可选：改用另一份报价单 Word 模板。
# QUOTATION_TEMPLATE_PATH=C:\Path\To\quotation_template.docx
